uint8_t const* tud_descriptor_configuration_cb(uint8_t index) {
    uint32_t hid_desc_offset = TUD_CONFIG_DESC_LEN + TUD_HID_DESC_LEN + 7;
    desc_configuration[hid_desc_offset]     = our_descriptor->descriptor_length & 0xFF;
    desc_configuration[hid_desc_offset + 1] = (our_descriptor->descriptor_length >> 8) & 0xFF;
    return desc_configuration;
}


uint8_t const* tud_hid_descriptor_report_cb(uint8_t instance) {
    if (instance == ITF_NUM_PEDAL) {
        return pedal_report_descriptor;
    } else if (instance == ITF_NUM_HID) {
        return our_descriptor->descriptor;
    } else {
        return config_report_descriptor;
    }
}
