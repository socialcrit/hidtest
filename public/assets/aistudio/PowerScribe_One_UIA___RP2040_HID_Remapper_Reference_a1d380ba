}


^!r:: {
    try {
        psRoot := UIA.ElementFromHandle("ahk_exe Nuance.PSOne.exe")
        editor := psRoot.FindElement({Type: "Document"})
        currentText := editor.Value
        MsgBox("Character count: " StrLen(currentText), "PSOne Report Text")
        editor.SetFocus()
    } catch Error as e {
        ToolTip("Editor not found: " e.Message)
        SetTimer(() => ToolTip(), -2500)
    }
}
#HotIf
